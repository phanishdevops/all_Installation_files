# For Intel Macs
[ $(uname -m) = x86_64 ] && curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.33.0/kind-darwin-amd64

# For M1 / ARM Macs
[ $(uname -m) = arm64 ] && curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.33.0/kind-darwin-arm64

chmod +x ./kind

mv ./kind /some-dir-in-your-PATH/kind

#To install kind use: 
go install sigs.k8s.io/kind@v0.33.0

# To add nodes to cluster
vim kind-cluster.yaml
  kind: Cluster
  apiVersion: kind.x-k8s.io/v1alpha4
  nodes:
  - role: control-plane
  - role: worker
  - role: worker
  - role: worker
#wq(save it)

#To install kind cluster:
kind create cluster --name phanish-cluster --config=kind-cluster.yaml

# To show all the clusters 
kubectl config view | grep kind

kubectl use-context kind-multi(kind-multi is the clustername)

#It switches to kind-multi cluster
kubectl config use-context kind-multi


